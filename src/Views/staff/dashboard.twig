<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Staff Dashboard - Student Course Hub</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --primary-color: #2c3e50;        /* Same color as navbar/footer */
            --primary-variant: #34495e;      /* Primary color variation */
            --secondary-color: #2574A9;      /* Secondary site color */
            --accent-color: #e74c3c;         /* Site accent color */
            --success-color: #27ae60;        /* Site green */
            --warning-color: #f39c12;        /* Site orange */
            --error-color: #e74c3c;          /* Red for errors */
            --gray-50: #f8f9fa;
            --gray-100: #ecf0f1;
            --gray-200: #e9ecef;
            --gray-300: #cbd5e1;
            --gray-400: #94a3b8;
            --gray-500: #64748b;
            --gray-600: #475569;
            --gray-700: #334155;
            --gray-800: #1e293b;
            --gray-900: #0f172a;
            --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
            --shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
            --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
            --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
            --shadow-xl: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);
            --radius: 0.5rem;
            --radius-lg: 0.75rem;
            --radius-xl: 1rem;
            --transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }
        
        body {
            background-color: var(--gray-50);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        
        .navbar {
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-variant) 100%);
            box-shadow: var(--shadow-md);
            min-height: 60px;
            height: 64px;
            padding-top: 0.5rem;
            padding-bottom: 0.5rem;
            display: flex;
            align-items: center;
        }
        .navbar .container-fluid {
            min-height: 60px;
            height: 64px;
            display: flex;
            align-items: center;
        }
        .navbar-brand {
            font-size: 1.25rem;
            font-weight: 600;
            letter-spacing: 0.5px;
            display: flex;
            align-items: center;
        }
        .navbar-brand i {
            font-size: 1.25rem;
            margin-right: 0.5rem;
            vertical-align: middle;
        }
        .navbar .navbar-text, .navbar .nav-link {
            font-size: 1.1rem;
        }
        
        .sidebar {
            background: white;
            min-height: 100vh;
            box-shadow: var(--shadow-lg);
        }
        
        .sidebar .nav-link {
            color: var(--gray-700);
            padding: 12px 20px;
            border-radius: var(--radius);
            margin: 2px 10px;
            transition: var(--transition);
        }
        
        .sidebar .nav-link:hover,
        .sidebar .nav-link.active {
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-variant) 100%);
            color: white;
            transform: translateX(5px);
            box-shadow: var(--shadow-md);
        }
        
        .main-content {
            padding: 2rem;
        }
        
        .card {
            border: none;
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow);
            transition: var(--transition);
        }
        
        .card:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow-lg);
        }
        
        .card-header {
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-variant) 100%);
            color: white;
            border-radius: var(--radius-lg) var(--radius-lg) 0 0 !important;
            border: none;
        }
        
        .stats-card {
            background: linear-gradient(135deg, var(--secondary-color) 0%, var(--primary-color) 100%);
            color: white;
        }
        
        .module-item {
            background: white;
            border-radius: var(--radius);
            padding: 1rem;
            margin-bottom: 1rem;
            border-left: 4px solid var(--secondary-color);
            transition: var(--transition);
        }
        
        .module-item:hover {
            box-shadow: var(--shadow-lg);
            transform: translateX(5px);
        }
        
        .programme-item {
            background: white;
            border-radius: var(--radius);
            padding: 1.5rem;
            margin-bottom: 1rem;
            border: 1px solid var(--gray-200);
            transition: var(--transition);
        }
        
        .programme-item:hover {
            box-shadow: var(--shadow-lg);
            border-color: var(--secondary-color);
        }
        
        .btn-custom {
            background: linear-gradient(135deg, var(--secondary-color) 0%, var(--primary-color) 100%);
            border: none;
            border-radius: var(--radius);
            color: white;
            padding: 10px 20px;
            transition: var(--transition);
        }
        
        .btn-custom:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
            color: white;
        }

        /* Styles for content sections */
        .content-section {
            transition: var(--transition);
        }

        .content-section.fade-in {
            animation: fadeIn 0.5s ease-in-out;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Styles for overview section cards */
        #dashboard-overview .text-center {
            transition: var(--transition);
            cursor: pointer;
            border-radius: var(--radius);
            padding: 1.5rem;
        }

        #dashboard-overview .text-center:hover {
            background: rgba(37, 116, 169, 0.05);
            box-shadow: var(--shadow-md);
        }

        #dashboard-overview .text-center i {
            transition: var(--transition);
        }

        #dashboard-overview .text-center:hover i {
            transform: scale(1.1);
        }

        /* Styles for active navigation */
        .sidebar .nav-link.active {
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-variant) 100%);
            color: white;
            transform: translateX(5px);
            box-shadow: var(--shadow-md);
        }

        /* Styles for badges */
        .badge.bg-primary {
            background: var(--secondary-color) !important;
        }

        .badge.bg-success {
            background: var(--success-color) !important;
        }

        /* Styles for tables */
        .table {
            border-radius: var(--radius);
            overflow: hidden;
        }

        .table thead th {
            background: var(--gray-100);
            border-bottom: 2px solid var(--gray-200);
            color: var(--gray-700);
            font-weight: 600;
        }

        .table tbody tr:hover {
            background: var(--gray-50);
        }

        /* Styles for links */
        a {
            color: var(--secondary-color);
            transition: var(--transition);
        }

        a:hover {
            color: var(--primary-color);
        }
    </style>
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="#">
                <i class="fas fa-graduation-cap me-2"></i>
                Staff Portal
            </a>
            <div class="navbar-nav ms-auto">
                <span class="navbar-text me-3">
                    <i class="fas fa-user me-1"></i>
                    {{ staff_member.full_name }}
                </span>
                <a class="nav-link" href="{{ base_path() }}/staff/logout">
                    <i class="fas fa-sign-out-alt me-1"></i>Logout
                </a>
            </div>
        </div>
    </nav>

    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <div class="col-md-3 col-lg-2 sidebar p-0">
                <div class="p-3">
                    <div class="text-center mb-4">
                        <img src="{{ staff_member.photo_url ?? '/images/default-avatar.svg' }}" 
                             alt="Profile" 
                             class="rounded-circle" 
                             style="width: 80px; height: 80px; object-fit: cover;">
                        <h6 class="mt-2 mb-0">{{ staff_member.full_name }}</h6>
                        <small class="text-muted">{{ staff_member.title }}</small>
                    </div>
                    
                    <nav class="nav flex-column">
                        <a class="nav-link active" href="#dashboard-overview">
                            <i class="fas fa-tachometer-alt me-2"></i>Dashboard
                        </a>
                        <a class="nav-link" href="#modules">
                            <i class="fas fa-book me-2"></i>My Modules
                        </a>
                        <a class="nav-link" href="#programmes">
                            <i class="fas fa-graduation-cap me-2"></i>My Programmes
                        </a>
                        <a class="nav-link" href="#interests">
                            <i class="fas fa-users me-2"></i>Student Interests
                        </a>
                        <a class="nav-link" href="#profile">
                            <i class="fas fa-user me-2"></i>Profile
                        </a>
                    </nav>
                </div>
            </div>

            <!-- Main Content -->
            <div class="col-md-9 col-lg-10 main-content">
                <!-- Welcome Section -->
                <div class="row mb-4">
                    <div class="col-12">
                        <h2 class="mb-3">
                            <i class="fas fa-user-tie me-2"></i>
                            Welcome back, {{ staff_member.full_name }}!
                        </h2>
                        <p class="text-muted">
                            Here's an overview of your teaching responsibilities and impact across courses.
                        </p>
                    </div>
                </div>

                <!-- Stats Cards -->
                <div class="row mb-4">
                    <div class="col-md-3">
                        <div class="card stats-card">
                            <div class="card-body text-center">
                                <i class="fas fa-book fa-2x mb-2"></i>
                                <h4>{{ led_modules|length }}</h4>
                                <p class="mb-0">Modules Leading</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card stats-card">
                            <div class="card-body text-center">
                                <i class="fas fa-graduation-cap fa-2x mb-2"></i>
                                <h4>{{ programmes_with_modules|length }}</h4>
                                <p class="mb-0">Programmes Involved</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card stats-card">
                            <div class="card-body text-center">
                                <i class="fas fa-users fa-2x mb-2"></i>
                                <h4>{{ student_interests|length }}</h4>
                                <p class="mb-0">Student Interests</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card stats-card">
                            <div class="card-body text-center">
                                <i class="fas fa-building fa-2x mb-2"></i>
                                <h4>{{ staff_member.department }}</h4>
                                <p class="mb-0">Department</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Dashboard Overview Section (Default Visible) -->
                <div class="content-section" id="dashboard-overview">
                    <div class="row mb-4">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-header">
                                    <h5 class="mb-0">
                                        <i class="fas fa-chart-line me-2"></i>
                                        Dashboard Overview
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <p class="text-muted">
                                        Welcome to your staff dashboard! Use the navigation menu on the left to explore your modules, programmes, and student interests.
                                    </p>
                                    <div class="row">
                                        <div class="col-md-4">
                                            <div class="text-center p-3">
                                                <i class="fas fa-book fa-3x text-primary mb-3"></i>
                                                <h6>View and manage the modules you're leading</h6>
                                                <p class="text-muted">View and manage the modules you're leading</p>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="text-center p-3">
                                                <i class="fas fa-graduation-cap fa-3x text-success mb-3"></i>
                                                <h6>My Programmes</h6>
                                                <p class="text-muted">See the programmes you're involved in</p>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="text-center p-3">
                                                <i class="fas fa-users fa-3x text-info mb-3"></i>
                                                <h6>Student Interests</h6>
                                                <p class="text-muted">Connect with interested students</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Modules Section (Hidden by Default) -->
                <div class="content-section" id="modules" style="display: none;">
                    <div class="row mb-4">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-header">
                                    <h5 class="mb-0">
                                        <i class="fas fa-book me-2"></i>
                                        Modules I'm Leading
                                    </h5>
                                </div>
                                <div class="card-body">
                                    {% if led_modules %}
                                        {% for module in led_modules %}
                                            <div class="module-item">
                                                <div class="row align-items-center">
                                                    <div class="col-md-8">
                                                        <h6 class="mb-1">{{ module.title }}</h6>
                                                        <p class="text-muted mb-1">
                                                            <i class="fas fa-graduation-cap me-1"></i>
                                                            {{ module.programme_title }} ({{ module.programme_level }})
                                                        </p>
                                                        <small class="text-muted">
                                                            <i class="fas fa-calendar me-1"></i>
                                                            Year {{ module.year }} • {{ module.credits }} credits
                                                        </small>
                                                    </div>
                                                    <div class="col-md-4 text-end">
                                                        <span class="badge bg-primary">{{ module.programme_level }}</span>
                                                    </div>
                                                </div>
                                            </div>
                                        {% endfor %}
                                    {% else %}
                                        <div class="text-center py-4">
                                            <i class="fas fa-book fa-3x text-muted mb-3"></i>
                                            <h5 class="text-muted">No modules assigned yet</h5>
                                            <p class="text-muted">You haven't been assigned as a module leader yet.</p>
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Programmes Section (Hidden by Default) -->
                <div class="content-section" id="programmes" style="display: none;">
                    <div class="row">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-header">
                                    <h5 class="mb-0">
                                        <i class="fas fa-graduation-cap me-2"></i>
                                        Programmes I'm Involved In
                                    </h5>
                                </div>
                                <div class="card-body">
                                    {% if programmes_with_modules %}
                                        {% for programme in programmes_with_modules %}
                                            <div class="programme-item">
                                                <div class="row align-items-center">
                                                    <div class="col-md-8">
                                                        <h6 class="mb-1">{{ programme.title }}</h6>
                                                        <p class="text-muted mb-1">
                                                            <i class="fas fa-book me-1"></i>
                                                            {{ programme.module_count }} module(s) taught
                                                        </p>
                                                        <small class="text-muted">
                                                            <i class="fas fa-clock me-1"></i>
                                                            {{ programme.duration_years }} year(s) • {{ programme.level }} level
                                                        </small>
                                                    </div>
                                                    <div class="col-md-4 text-end">
                                                        <span class="badge bg-success">{{ programme.level }}</span>
                                                        <a href="{{ base_path() }}/programme/{{ programme.id }}" 
                                                           class="btn btn-custom btn-sm ms-2">
                                                            <i class="fas fa-eye me-1"></i>View
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                        {% endfor %}
                                    {% else %}
                                        <div class="text-center py-4">
                                            <i class="fas fa-graduation-cap fa-3x text-muted mb-3"></i>
                                            <h5 class="text-muted">No programmes found</h5>
                                            <p class="text-muted">You're not currently involved in any programmes.</p>
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Student Interests Section (Hidden by Default) -->
                <div class="content-section" id="interests" style="display: none;">
                    <div class="row">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-header">
                                    <h5 class="mb-0">
                                        <i class="fas fa-users me-2"></i>
                                        Student Interests in My Modules
                                    </h5>
                                </div>
                                <div class="card-body">
                                    {% if student_interests %}
                                        <div class="table-responsive">
                                            <table class="table table-hover">
                                                <thead>
                                                    <tr>
                                                        <th>Student Name</th>
                                                        <th>Email</th>
                                                        <th>Programme</th>
                                                        <th>Module</th>
                                                        <th>Registration Date</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    {% for interest in student_interests %}
                                                        <tr>
                                                            <td>
                                                                <strong>{{ interest.student_name }}</strong>
                                                            </td>
                                                            <td>
                                                                <a href="mailto:{{ interest.email }}" class="text-decoration-none">
                                                                    {{ interest.email }}
                                                                </a>
                                                            </td>
                                                            <td>
                                                                <span class="badge bg-primary">{{ interest.programme_title }}</span>
                                                            </td>
                                                            <td>
                                                                <small class="text-muted">{{ interest.module_title }}</small>
                                                            </td>
                                                            <td>
                                                                <small class="text-muted">
                                                                    {{ interest.created_at|date('M d, Y') }}
                                                                </small>
                                                            </td>
                                                        </tr>
                                                    {% endfor %}
                                                </tbody>
                                            </table>
                                        </div>
                                        <div class="mt-3">
                                            <small class="text-muted">
                                                <i class="fas fa-info-circle me-1"></i>
                                                Showing {{ student_interests|length }} student(s) interested in your modules
                                            </small>
                                        </div>
                                    {% else %}
                                        <div class="text-center py-4">
                                            <i class="fas fa-users fa-3x text-muted mb-3"></i>
                                            <h5 class="text-muted">No student interests yet</h5>
                                            <p class="text-muted">Students haven't registered interest in your modules yet.</p>
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="{{ base_path() }}/js/staff-dashboard.js"></script>
</body>
</html> 