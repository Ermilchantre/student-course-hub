<!DOCTYPE html>
<!-- ==================================================
   DOCUMENT TYPE
   Purpose: Defines the document as HTML5.
   Functionality: Ensures proper rendering in browsers.
   Client-Side Role: Sets the HTML5 standard.
   Logic: Uses DOCTYPE for compatibility.
-->
<html lang="en">
<!-- ==================================================
   HTML ELEMENT
   Purpose: Root element of the page.
   Functionality: Sets English language for accessibility.
   Client-Side Role: Contains all page content.
   Logic: Uses lang="en" for multilingual support.
-->
<head>
    <!-- ==================================================
       HEAD SECTION
       Purpose: Configures metadata and external resources.
       Functionality: Includes encoding, viewport, title, CSS, and fonts.
       Client-Side Role: Defines page appearance and behavior.
       Logic: Loads styles and fonts for layout.
    -->
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin & Staff Login - Student Course Hub</title>
    <link rel="stylesheet" href="{{ base_path() }}/css/admin-login.css">
    <link rel="stylesheet" href="https://unicons.iconscout.com/release/v2.1.6/css/unicons.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
</head>
<body>
    <!-- ==================================================
       BODY SECTION
       Purpose: Contains visible page content.
       Functionality: Structures login form and footer.
       Client-Side Role: Renders login interface.
       Logic: Organizes layout with wrapper, card, and form.
    -->
    <div class="login-wrapper">
        <div class="login-card">
            <div class="login-user-icon">
                <i class="uil uil-user-circle"></i>
            </div>
            <h1>Admin & Staff Login</h1>
            <p class="login-subtitle">Access your dashboard</p>
            <form class="login-form" id="admin-login-form" aria-label="Login form" method="POST" action="{{ base_path() }}/admin/login">
                <div class="form-group icon-left input-icon-group">
                    <span class="input-icon"><i class="uil uil-envelope"></i></span>
                    <input type="email" id="email" name="email" required autocomplete="username" placeholder="Enter your email">
                </div>
                <div class="form-group icon-left input-icon-group" style="position: relative;">
                    <span class="input-icon"><i class="uil uil-lock"></i></span>
                    <input type="password" id="password" name="password" required autocomplete="current-password" placeholder="Enter your password">
                    <button type="button" id="toggle-password" aria-label="Show or hide password" class="toggle-password-btn">
                        <i class="uil uil-eye"></i>
                    </button>
                </div>
                <div class="forgot-password-link">
                    <a href="{{ base_path() }}/admin/forgot-password">Forgot your password?</a>
                </div>
                <div class="form-message" id="form-message" style="display:none;"></div>
                <button type="submit" class="btn btn-primary"><i class="uil uil-signin"></i> Sign In</button>
                <div class="back-to-home-form">
                    <a href="/" class="back-link-form">
                        <i class="uil uil-arrow-left"></i>
                        <span>Back to Home</span>
                    </a>
                </div>
            </form>
            <div class="login-footer">
                <!-- Placeholder for future content -->
            </div>
        </div>
    </div>
    <footer>
        <!-- ==================================================
           FOOTER SECTION
           Purpose: Displays copyright information.
           Functionality: Shows copyright notice.
           Client-Side Role: Provides legal information.
           Logic: Uses static text for 2025.
        -->
        <p>© 2025 Student Course Hub. All rights reserved.</p>
    </footer>
    <script src="{{ base_path() }}/js/admin-login.js"></script>
    <!-- ==================================================
       SCRIPT SECTION
       Purpose: Loads JavaScript for interactivity.
       Functionality: Adds form functionality.
       Client-Side Role: Enhances user experience.
       Logic: Loads script via base_path().
    -->
</body>
</html>