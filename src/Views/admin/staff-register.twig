<!DOCTYPE html>
<!-- ==================================================
   DOCUMENT TYPE
   Purpose: Declares the document as HTML5 to ensure standardized rendering.
   Functionality: Instructs browsers to use HTML5 standards, supporting modern web features and consistent parsing.
   Client-Side Role: Ensures compatibility with modern browsers for proper page display.
   Logic: Uses DOCTYPE declaration to prevent quirks mode and enforce HTML5 rendering.
-->
<html lang="en">
<!-- ==================================================
   HTML ELEMENT
   Purpose: Root container for the Register Staff page, specifying the document language.
   Functionality: Sets English as the language for accessibility and contains all page content.
   Client-Side Role: Encapsulates navigation, header, form, and scripts for staff registration.
   Logic: Uses lang="en" to support screen readers and ensure proper text directionality.
-->
<head>
    <!-- ==================================================
       HEAD SECTION
       Purpose: Configures metadata, page title, and external resources for styling and functionality.
       Functionality: Defines character encoding, responsive viewport, title, and links to CSS and fonts.
       Client-Side Role: Controls visual presentation and resource loading for the staff registration page.
       Logic: Loads multiple stylesheets (admin-nav.css, admin-dashboard.css, admin-staff.css, register-interest.css), Unicons, and Montserrat font.
    -->
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register Staff - Student Course Hub</title>
    <link rel="stylesheet" href="{{ base_path() }}/css/admin-nav.css">
    <link rel="stylesheet" href="{{ base_path() }}/css/admin-dashboard.css">
    <link rel="stylesheet" href="{{ base_path() }}/css/admin-staff.css">
    <link rel="stylesheet" href="https://unicons.iconscout.com/release/v2.1.6/css/unicons.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ base_path() }}/css/register-interest.css">
</head>
<body class="admin-staff-register-page">
    <!-- ==================================================
       BODY SECTION
       Purpose: Contains all visible content for registering new staff members.
       Functionality: Structures navigation, header, and form for staff registration with a specific page class.
       Client-Side Role: Renders an interactive interface for admins to register staff with dynamic input handling.
       Logic: Uses semantic HTML and class (admin-staff-register-page) for page-specific styling and JavaScript-driven functionality.
    -->
    <nav>
        <!-- ==================================================
           NAVIGATION SECTION
           Purpose: Provides navigation for accessing dashboard features and user actions.
           Functionality: Includes a home link, admin dropdown menu, and responsive menu toggles.
           Client-Side Role: Enables admins to navigate between dashboard sections and log out.
           Logic: Uses dynamic URLs via base_path() and JavaScript for mobile menu toggling with accessibility support.
        -->
        <div class="container nav_container">
            <a href="{{ base_path() }}"><h4><i class="uil uil-graduation-cap"></i> Student Course Hub</h4></a>
            <div class="nav_right">
                <ul class="nav_menu">
                    <li class="dropdown">
                        <a href="#" class="active"><i class="uil uil-user"></i> Admin <i class="uil uil-angle-down"></i></a>
                        <ul class="dropdown-menu">
                            <li><a href="{{ base_path() }}/admin/dashboard"><i class="uil uil-home"></i> Dashboard</a></li>
                            <li><a href="{{ base_path() }}/admin/programmes"><i class="uil uil-notebooks"></i> Programs</a></li>
                            <li><a href="{{ base_path() }}/admin/modules"><i class="uil uil-book-open"></i> Modules</a></li>
                            <li><a href="{{ base_path() }}/admin/interests"><i class="uil uil-clipboard-notes"></i> Interests</a></li>
                        </ul>
                    </li>
                </ul>
                <button id="open-menu-btn" aria-label="Open navigation menu"><i class="uil uil-bars"></i></button>
                <button id="close-menu-btn" aria-label="Close navigation menu"><i class="uil uil-multiply"></i></button>
                <a href="{{ base_path() }}/admin/logout" class="logout-btn" aria-label="Logout"><i class="uil uil-signout"></i> Logout</a>
            </div>
        </div>
    </nav>

    <header class="register-header">
        <!-- ==================================================
           HEADER SECTION
           Purpose: Introduces the staff registration page with key benefits.
           Functionality: Displays a title, description, and benefits of registering staff members.
           Client-Side Role: Provides an overview of the page’s purpose and capabilities for admins.
           Logic: Uses a two-column layout with text and an icon for visual clarity and guidance.
        -->
        <div class="container register-header_container">
            <div class="register-header_left">
                <h1>Register New Staff Member</h1>
                <p>Add a new staff member to your institution. Fill in the details below to register a new staff profile for your academic or administrative team.</p>
                <div class="register-benefits">
                    <div class="benefit">
                        <i class="uil uil-user-plus"></i>
                        <span>Enable staff to manage modules and programmes</span>
                    </div>
                    <div class="benefit">
                        <i class="uil uil-building"></i>
                        <span>Assign departments and specializations</span>
                    </div>
                    <div class="benefit">
                        <i class="uil uil-phone"></i>
                        <span>Keep contact and office info up to date</span>
                    </div>
                </div>
            </div>
            <div class="register-header_right">
                <div class="register-image">
                    <i class="uil uil-user"></i>
                </div>
            </div>
        </div>
    </header>

    <section class="register-form">
        <!-- ==================================================
           REGISTER FORM SECTION
           Purpose: Provides a form for registering new staff members.
           Functionality: Collects staff details like title, name, email, department, and photo with validation.
           Client-Side Role: Enables admins to create staff profiles with accessibility and dynamic input handling.
           Logic: Uses form with file upload support and JavaScript for validation and dynamic specialization input.
        -->
        <div class="container register-form_container">
            <!-- Purpose: Wraps the form for layout and styling.
               Functionality: Organizes form elements within a container for a clean presentation.
               Client-Side Role: Ensures form elements are visually structured for usability.
               Logic: Uses CSS classes for responsive layout and consistent styling.
            -->
            <div class="form-wrapper">
                <!-- Purpose: Groups form content with a title for clarity.
                   Functionality: Displays a heading and contains the staff registration form.
                   Client-Side Role: Provides clear context for the form’s purpose.
                   Logic: Uses a wrapper div to encapsulate form elements and title.
                -->
                <h2>Staff Information</h2>
                
                {# 
                <!-- Purpose: Displays error or success messages based on query parameters (commented out).
                   Functionality: Shows alerts for password errors or successful registration.
                   Client-Side Role: Informs admins of submission outcomes (inactive in current code).
                   Logic: Uses template logic to conditionally render alerts based on query parameters.
                -->
                {% if request.getQueryParams().error == 'password_length' %}
                <div class="alert alert-error">
                    <i class="uil uil-exclamation-triangle"></i>
                    Password must be between 6 and 20 characters long.
                </div>
                {% endif %}
                
                {% if request.getQueryParams().success == '1' %}
                <div class="alert alert-success">
                    <i class="uil uil-check-circle"></i>
                    Staff member registered successfully!
                </div>
                {% endif %}
                #}
                
                <form id="staff-form" action="{{ base_path() }}/admin/staff/register" method="post" enctype="multipart/form-data" class="staff-form">
                    <!-- Purpose: Defines the form for registering a new staff member.
                       Functionality: Collects staff data with required fields and file upload, submitted via POST.
                       Client-Side Role: Facilitates staff profile creation with validation and minimal accessibility support.
                       Logic: Uses enctype for file uploads and JavaScript for validation; lacks aria attributes for full accessibility.
                    -->
                    <div class="form-grid">
                        <!-- Purpose: Groups the title selection field in a grid layout.
                           Functionality: Organizes the title dropdown for better usability.
                           Client-Side Role: Enhances form layout for clarity and responsiveness.
                           Logic: Uses CSS grid for structured field arrangement.
                        -->
                        <div class="form-group">
                            <!-- Purpose: Collects the staff member’s title.
                               Functionality: Provides a dropdown for selecting a formal title (e.g., Prof., Dr.).
                               Client-Side Role: Specifies the staff member’s formal title.
                               Logic: Uses select element with predefined options; should add required and aria attributes for accessibility.
                            -->
                            <label for="title">Title *</label>
                            <select id="title" name="title">
                                <option value="">Selecione o título</option>
                                <option value="Prof.">Prof.</option>
                                <option value="Dr.">Dr.</option>
                                <option value="Mr.">Mr.</option>
                                <option value="Mrs.">Mrs.</option>
                                <option value="Ms.">Ms.</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-grid">
                        <!-- Purpose: Groups full name and email fields in a grid layout.
                           Functionality: Organizes related input fields for better usability.
                           Client-Side Role: Enhances form layout for clarity and responsiveness.
                           Logic: Uses CSS grid for structured field arrangement.
                        -->
                        <div class="form-group">
                            <!-- Purpose: Collects the staff member’s full name.
                               Functionality: Allows input of a name with validation.
                               Client-Side Role: Captures the staff member’s identity.
                               Logic: Uses required text input; lacks aria attributes for accessibility.
                            -->
                            <label for="full_name">Full Name *</label>
                            <input type="text" id="full_name" name="full_name" placeholder="Full Name">
                        </div>
                        <div class="form-group">
                            <!-- Purpose: Collects the staff member’s email address.
                               Functionality: Allows input of an email with format validation.
                               Client-Side Role: Captures contact information for communication.
                               Logic: Uses email input type; should add required and aria attributes for accessibility.
                            -->
                            <label for="email">Email *</label>
                            <input type="email" id="email" name="email" placeholder="Email">
                        </div>
                    </div>
                    <div class="form-grid">
                        <!-- Purpose: Groups username and department fields in a grid layout.
                           Functionality: Organizes related input fields for better usability.
                           Client-Side Role: Enhances form layout for clarity and responsiveness.
                           Logic: Uses CSS grid for structured field arrangement.
                        -->
                        <div class="form-group">
                            <!-- Purpose: Collects the staff member’s username.
                               Functionality: Allows input of a unique username with validation.
                               Client-Side Role: Provides a login identifier for the staff member.
                               Logic: Uses required text input; lacks aria attributes for accessibility.
                            -->
                            <label for="username">Username *</label>
                            <input type="text" id="username" name="username" placeholder="Username">
                        </div>
                        <div class="form-group">
                            <!-- Purpose: Collects the staff member’s department.
                               Functionality: Provides a dropdown for selecting a department.
                               Client-Side Role: Assigns the staff member to an academic department.
                               Logic: Uses select element with predefined options; should add required and aria attributes.
                            -->
                            <label for="department">Department *</label>
                            <select id="department" name="department">
                                <option value="">Select department</option>
                                <option value="Computer Science">Computer Science</option>
                                <option value="Mathematics">Mathematics</option>
                                <option value="Engineering">Engineering</option>
                                <option value="Business">Business</option>
                                <option value="Humanities">Humanities</option>
                                <option value="Physics">Physics</option>
                                <option value="Arts">Arts</option>
                                <option value="Security">Security</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-grid">
                        <!-- Purpose: Groups specialization and phone fields in a grid layout.
                           Functionality: Organizes related input fields for better usability.
                           Client-Side Role: Enhances form layout for clarity and responsiveness.
                           Logic: Uses CSS grid for structured field arrangement.
                        -->
                        <div class="form-group">
                            <!-- Purpose: Collects the staff member’s specialization.
                               Functionality: Provides a dropdown with an optional custom input for specialization.
                               Client-Side Role: Specifies the staff member’s area of expertise.
                               Logic: Toggles custom input visibility via JavaScript; should add required and aria attributes.
                            -->
                            <label for="specialization">Specialization *</label>
                            <select id="specialization" name="specialization" onchange="toggleOtherSpecialization()">
                                <option value="">Select specialization</option>
                                <option value="Artificial Intelligence">Artificial Intelligence</option>
                                <option value="Data Science">Data Science</option>
                                <option value="Networks">Networks</option>
                                <option value="Software Engineering">Software Engineering</option>
                                <option value="Cybersecurity">Cybersecurity</option>
                                <option value="Mathematics">Mathematics</option>
                                <option value="Other">Other</option>
                            </select>
                            <input type="text" id="other_specialization" name="other_specialization" placeholder="Enter specialization" style="display:none; margin-top:0.7rem;" />
                        </div>
                        <div class="form-group">
                            <!-- Purpose: Collects the staff member’s phone number.
                               Functionality: Allows input of a phone number with validation.
                               Client-Side Role: Captures contact information for communication.
                               Logic: Uses required text input; lacks aria attributes for accessibility.
                            -->
                            <label for="phone">Phone *</label>
                            <input type="text" id="phone" name="phone" placeholder="Phone number">
                        </div>
                    </div>
                    <div class="form-grid">
                        <!-- Purpose: Groups office location and photo fields in a grid layout.
                           Functionality: Organizes related input fields for better usability.
                           Client-Side Role: Enhances form layout for clarity and responsiveness.
                           Logic: Uses CSS grid for structured field arrangement.
                        -->
                        <div class="form-group">
                            <!-- Purpose: Collects the staff member’s office location.
                               Functionality: Provides a dropdown for selecting an office location.
                               Client-Side Role: Specifies the staff member’s workplace for accessibility.
                               Logic: Uses select element with predefined options; should add required and aria attributes.
                            -->
                            <label for="office_location">Office Location *</label>
                            <select id="office_location" name="office_location">
                                <option value="">Select location</option>
                                <option value="CS Building - 1st Floor - Room 101">CS Building - 1st Floor - Room 101</option>
                                <option value="CS Building - 2nd Floor - Room 202">CS Building - 2nd Floor - Room 202</option>
                                <option value="DS Building - 1st Floor - Room 110">DS Building - 1st Floor - Room 110</option>
                                <option value="Business Building - 3rd Floor - Room 305">Business Building - 3rd Floor - Room 305</option>
                                <option value="Physics Building - Ground Floor - Room 001">Physics Building - Ground Floor - Room 001</option>
                                <option value="Arts Building - 2nd Floor - Room 210">Arts Building - 2nd Floor - Room 210</option>
                                <option value="Security Building - 1st Floor - Room 115">Security Building - 1st Floor - Room 115</option>
                                <option value="Mathematics Building - 2nd Floor - Room 220">Mathematics Building - 2nd Floor - Room 220</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <!-- Purpose: Collects an optional photo for the staff member.
                               Functionality: Allows file upload for a profile image with a custom label.
                               Client-Side Role: Enhances staff profile with a visual element.
                               Logic: Uses hidden file input with styled label; lacks aria attributes for accessibility.
                            -->
                            <label for="photo">Photo</label>
                            <label for="photo" class="photo-upload-label"><i class="uil uil-image-plus"></i> Choose Photo</label>
                            <input type="file" id="photo" name="photo" accept="image/*">
                        </div>
                    </div>
                    <div class="form-group">
                        <!-- Purpose: Collects a short biography for the staff member.
                           Functionality: Allows input of a multi-line bio with validation.
                           Client-Side Role: Provides context about the staff member’s background.
                           Logic: Uses required textarea; lacks aria attributes for accessibility.
                        -->
                        <label for="bio">Bio *</label>
                        <textarea id="bio" name="bio" rows="4" placeholder="Short biography"></textarea>
                    </div>
                    <div class="form-group">
                        <!-- Purpose: Collects the staff member’s password.
                           Functionality: Allows input of a password with length constraints and guidance.
                           Client-Side Role: Secures the staff member’s account with a password.
                           Logic: Uses password input with minlength/maxlength; lacks aria attributes for accessibility.
                        -->
                        <label for="password">Password *</label>
                        <input type="password" id="password" name="password" placeholder="Enter a password (6-20 characters)" minlength="6" maxlength="20">
                        <small class="form-help">Password must be between 6 and 20 characters</small>
                    </div>
                    <div class="form-group">
                        <!-- Purpose: Specifies if the staff member’s account is active.
                           Functionality: Provides a checkbox to mark the account as active, defaulting to checked.
                           Client-Side Role: Controls the staff member’s account status.
                           Logic: Uses checkbox with default checked state; lacks aria attributes for accessibility.
                        -->
                        <label>
                            <input type="checkbox" name="is_active" checked>
                            Active
                        </label>
                    </div>
                    <button type="submit" class="btn btn-primary">
                        <!-- Purpose: Submits the staff registration form.
                           Functionality: Triggers form submission to register a new staff member.
                           Client-Side Role: Initiates the staff registration process.
                           Logic: Uses JavaScript for validation and submission; lacks aria-label for accessibility.
                        -->
                        <i class="uil uil-user-plus"></i> Register Staff
                    </button>
                </form>
            </div>
        </div>
    </section>
    
    <script src="{{ base_path() }}/js/admin-dashboard.js"></script>
    <script src="{{ base_path() }}/js/admin-staff.js"></script>
    <script>
    function toggleOtherSpecialization() {
        var select = document.getElementById('specialization');
        var otherInput = document.getElementById('other_specialization');
        if (select.value === 'Other') {
            otherInput.style.display = 'block';
            otherInput.required = true;
        } else {
            otherInput.style.display = 'none';
            otherInput.required = false;
        }
    }

    document.getElementById('staff-form').addEventListener('submit', function(e) {
        this.classList.add('was-validated');
    });
    </script>
</body>
</html> 