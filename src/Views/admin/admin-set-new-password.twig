<!DOCTYPE html>
<!-- ==================================================
   DOCUMENT TYPE
   Purpose: Declares the document as an HTML5 document to ensure proper rendering.
   Functionality: Informs browsers to use HTML5 standards for parsing and displaying the page.
   Client-Side Role: Establishes the foundation for modern web features and compatibility.
   Logic: Uses the DOCTYPE declaration to enforce standards-compliant rendering across all modern browsers.
-->
<html lang="en">
<!-- ==================================================
   HTML ELEMENT
   Purpose: Acts as the root container for all page content and defines the document language.
   Functionality: Sets the language to English, enhancing accessibility for screen readers and multilingual support.
   Client-Side Role: Encapsulates the entire webpage structure, including head and body sections.
   Logic: Specifies lang="en" to ensure proper text directionality and accessibility for English-speaking users.
-->
<head>
    <!-- ==================================================
       HEAD SECTION
       Purpose: Configures metadata, page title, and external resources for styling and functionality.
       Functionality: Defines character encoding, viewport settings, and links to CSS and font resources.
       Client-Side Role: Controls how the page is displayed, ensuring proper rendering and responsive design.
       Logic: Loads external stylesheets and fonts to provide consistent typography and layout across devices.
    -->
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Set New Password - Student Course Hub</title>
    <link rel="stylesheet" href="{{ base_path() }}/css/admin-login.css">
    <link rel="stylesheet" href="https://unicons.iconscout.com/release/v2.1.6/css/unicons.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
</head>
<body>
    <!-- ==================================================
       BODY SECTION
       Purpose: Contains the visible content of the password reset page.
       Functionality: Organizes the layout with a centered login card, form, and footer for a cohesive user interface.
       Client-Side Role: Renders the interactive password reset form and related elements for user interaction.
       Logic: Structures the page using div containers and CSS classes to ensure a responsive and visually appealing design.
    -->
    <div class="login-wrapper">
        <!-- ==================================================
           LOGIN WRAPPER
           Purpose: Centers and stylizes the login card within the page.
           Functionality: Acts as a container to position the login card in the viewport.
           Client-Side Role: Provides a clean, centered layout for the password reset interface.
           Logic: Uses CSS flexbox or grid (defined in admin-login.css) for responsive alignment.
        -->
        <div class="login-card">
            <div class="login-user-icon">
                <i class="uil uil-key-skeleton"></i>
            </div>
            <h1>Set New Password</h1>
            <p class="login-subtitle">Enter your new password below</p>
            <form class="login-form" id="set-password-form" aria-label="Set new password form" method="POST" action="{{ base_path() }}/admin/reset-password">
                <!-- ==================================================
                   FORM ELEMENT
                   Purpose: Provides a form for users to set a new password.
                   Functionality: Collects and submits new password data along with a reset token to the server.
                   Client-Side Role: Enables users to input and confirm their new password securely.
                   Logic: Uses POST method to send data to the reset-password endpoint, with token for validation.
                -->
                <input type="hidden" name="token" value="{{ token }}">
                <div class="form-group icon-left input-icon-group" style="position: relative;">
                    <!-- ==================================================
                       PASSWORD INPUT GROUP
                       Purpose: Collects the new password with a visual icon and toggle feature.
                       Functionality: Allows users to input a new password and toggle its visibility for ease of use.
                       Client-Side Role: Enhances user experience with secure input and visual feedback.
                       Logic: Combines input field, lock icon, and toggle button with relative positioning for layout.
                    -->
                    <span class="input-icon"><i class="uil uil-lock"></i></span>
                    <input type="password" id="password" name="password" required placeholder="New password">
                    <button type="button" class="toggle-password-btn" data-target="password" aria-label="Show or hide password">
                        <i class="uil uil-eye"></i>
                    </button>
                </div>
                <div class="form-group icon-left input-icon-group" style="position: relative;">
                    <span class="input-icon"><i class="uil uil-lock"></i></span>
                    <input type="password" id="password_confirm" name="password_confirm" required placeholder="Confirm new password">
                    <button type="button" class="toggle-password-btn" data-target="password_confirm" aria-label="Show or hide password">
                        <i class="uil uil-eye"></i>
                    </button>
                </div>
                <div class="form-message" id="form-message" style="display:none;"></div>
                <div class="form-message success" id="success-message" style="display:none;"></div>
                <button type="submit" class="btn btn-primary"><i class="uil uil-key-change"></i> Set Password</button>
                <div class="back-to-home-form">
                    <a href="{{ base_path() }}/admin/login" class="back-link-form">
                        <i class="uil uil-arrow-left"></i>
                        <span>Back to Login</span>
                    </a>
                </div>
            </form>
        </div>
    </div>
    <footer>
        <!-- ==================================================
           FOOTER SECTION
           Purpose: Displays copyright information for the Student Course Hub.
           Functionality: Presents a static copyright notice to indicate ownership and legal rights.
           Client-Side Role: Provides legal context at the bottom of the page.
           Logic: Uses static text with the year 2025 for simplicity and clarity.
        -->
        <p>© 2025 Student Course Hub. All rights reserved.</p>
    </footer>
    <script src="{{ base_path() }}/js/admin-login.js"></script>
    <!-- ==================================================
       SCRIPT SECTION
       Purpose: Loads JavaScript to enable interactive features on the page.
       Functionality: Adds functionality such as password visibility toggling and form validation.
       Client-Side Role: Enhances user interaction with dynamic behaviors.
       Logic: Uses base_path() for dynamic script path resolution, linking to admin-login.js.
    -->
</body>
</html>