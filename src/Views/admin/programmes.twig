<!DOCTYPE html>
<!-- ==================================================
   DOCUMENT TYPE
   Purpose: Declares the document as an HTML5 document to ensure standardized rendering.
   Functionality: Instructs browsers to parse the page using HTML5 standards, enabling modern web features.
   Client-Side Role: Ensures compatibility across modern browsers for consistent page display.
   Logic: Uses the DOCTYPE declaration to prevent quirks mode and enable HTML5 feature support.
-->
<html lang="en">
<!-- ==================================================
   HTML ELEMENT
   Purpose: Serves as the root container for the Manage Programmes page and specifies the document language.
   Functionality: Sets English as the language, enhancing accessibility for screen readers and multilingual users.
   Client-Side Role: Encapsulates all page content, including navigation, header, main content, and footer.
   Logic: Uses lang="en" to ensure proper text directionality and accessibility for English-speaking users.
-->
<head>
    <!-- ==================================================
       HEAD SECTION
       Purpose: Configures metadata, page title, and external resources for styling and functionality.
       Functionality: Defines character encoding, responsive viewport, page title, and links to CSS and fonts.
       Client-Side Role: Controls the visual presentation and resource loading for the programme management page.
       Logic: Loads local stylesheets (admin-nav.css, admin-programmes.css), Unicons, and Montserrat font for consistent design.
    -->
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Programmes - Student Course Hub</title>
    <link rel="stylesheet" href="{{ base_path() }}/css/admin-nav.css">
    <link rel="stylesheet" href="{{ base_path() }}/css/admin-programmes.css">
    <link rel="stylesheet" href="https://unicons.iconscout.com/release/v2.1.6/css/unicons.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
</head>
<body class="admin-programmes-page">
    <!-- ==================================================
       BODY SECTION
       Purpose: Contains all visible content for managing academic programmes.
       Functionality: Structures navigation, header, form for creating/editing programmes, and a table for viewing programmes.
       Client-Side Role: Renders an interactive interface for admins to create, edit, and manage programmes efficiently.
       Logic: Uses semantic HTML, CSS classes, and a specific class (admin-programmes-page) for page-specific styling.
    -->
    <nav>
        <!-- ==================================================
           NAVIGATION SECTION
           Purpose: Provides navigation for accessing dashboard features and user actions.
           Functionality: Includes a home link, admin dropdown menu with management options, and responsive menu toggles.
           Client-Side Role: Enables admins to navigate between dashboard sections and perform logout actions.
           Logic: Uses dynamic URLs via base_path() and JavaScript for mobile menu toggling with accessibility support.
        -->
        <div class="container nav_container">
            <a href="{{ base_path() }}"><h4><i class="uil uil-graduation-cap"></i> Student Course Hub</h4></a>
            <div class="nav_right">
                <ul class="nav_menu">
                    <li class="dropdown">
                        <a href="#" class="active"><i class="uil uil-user"></i> Admin <i class="uil uil-angle-down"></i></a>
                        <ul class="dropdown-menu">
                            <li><a href="{{ base_path() }}/admin/dashboard"><i class="uil uil-home"></i> Dashboard</a></li>
                            <li><a href="{{ base_path() }}/admin/modules"><i class="uil uil-book-open"></i> Modules</a></li>
                            <li><a href="{{ base_path() }}/admin/interests"><i class="uil uil-clipboard-notes"></i> Interests</a></li>
                        </ul>
                    </li>
                </ul>
                <button id="open-menu-btn" aria-label="Open navigation menu"><i class="uil uil-bars"></i></button>
                <button id="close-menu-btn" aria-label="Close navigation menu"><i class="uil uil-multiply"></i></button>
                <a href="{{ base_path() }}/admin/logout" class="logout-btn" aria-label="Logout"><i class="uil uil-signout"></i> Logout</a>
            </div>
        </div>
    </nav>

    <header class="admin-header">
        <!-- ==================================================
           HEADER SECTION
           Purpose: Introduces the programme management page with key statistics.
           Functionality: Displays a title, description, and dynamic stats for total and published programmes.
           Client-Side Role: Provides admins with an overview of programme-related metrics and page purpose.
           Logic: Uses JavaScript-updated placeholders (e.g., id="total-programmes") with a two-column layout.
        -->
        <div class="container header_container">
            <div class="header_left">
                <h1>Manage Programmes</h1>
                <p>Create, edit and organize academic programmes in a structured and efficient way.</p>
                <div class="header-stats">
                    <div class="stat-item">
                        <i class="uil uil-book-open"></i>
                        <span id="total-programmes">0 Programmes</span>
                    </div>
                    <div class="stat-item">
                        <i class="uil uil-check-circle"></i>
                        <span id="published-programmes">0 Published</span>
                    </div>
                    <div class="stat-item">
                        <i class="uil uil-clock"></i>
                        <span>Updated today</span>
                    </div>
                </div>
            </div>
            <div class="header_right">
                <div class="header_image">
                    <i class="uil uil-book-open"></i>
                </div>
            </div>
        </div>
    </header>

    <main>
        <!-- ==================================================
           MAIN SECTION
           Purpose: Contains the core functionality for managing academic programmes.
           Functionality: Includes a form for creating/editing programmes and a table for viewing registered programmes.
           Client-Side Role: Provides admins with tools to add, edit, search, and filter programmes dynamically.
           Logic: Uses semantic sections with JavaScript-driven form submission and table population.
        -->
        <div class="container">
            <section class="programme-form-section">
                <!-- ==================================================
                   PROGRAMME FORM SECTION
                   Purpose: Provides a form for creating or editing academic programmes.
                   Functionality: Collects programme details like title, level, duration, credits, and image, with validation.
                   Client-Side Role: Enables admins to define or modify programme details with accessibility features.
                   Logic: Uses dynamic inputs, file upload, and JavaScript for form handling and submission.
                -->
                <div class="section-header">
                    <!-- Purpose: Displays the title and instructions for the programme form.
                       Functionality: Shows a dynamic title (create/edit) and guidance text for form usage.
                       Client-Side Role: Clarifies the form’s purpose to admins.
                       Logic: Uses a span with id="form-title" for dynamic title updates via JavaScript.
                    -->
                    <h2><i class="uil uil-plus-circle"></i> <span id="form-title">Create New Programme</span></h2>
                    <p>Fill in the fields below to create a new programme or edit an existing one</p>
                </div>
                
                <div class="form-container">
                    <!-- Purpose: Wraps the programme form for layout and styling.
                       Functionality: Groups form elements for a clean, organized presentation.
                       Client-Side Role: Ensures form elements are visually structured for usability.
                       Logic: Uses CSS classes for responsive grid-based layout.
                    -->
                    <form id="programme-form" class="programme-form" aria-label="Form to create or edit programme" enctype="multipart/form-data">
                        <!-- Purpose: Defines the form for creating or editing a programme.
                           Functionality: Collects programme data with required and optional fields, supporting file uploads.
                           Client-Side Role: Facilitates user input for programme creation or editing with accessibility.
                           Logic: Uses aria-label and enctype for file uploads, with JavaScript for validation and submission.
                        -->
                        <div class="form-grid">
                            <!-- Purpose: Groups programme title and level selection fields in a grid layout.
                               Functionality: Organizes related input fields for better usability.
                               Client-Side Role: Enhances form layout for clarity and responsiveness.
                               Logic: Uses CSS grid for structured field arrangement.
                            -->
                            <div class="form-group">
                                <!-- Purpose: Collects the programme title.
                                   Functionality: Allows input of a text title with validation and guidance.
                                   Client-Side Role: Captures the programme’s unique name.
                                   Logic: Uses required input with accessibility attributes for user input validation.
                                -->
                                <label for="title" id="title-label">Programme Title *</label>
                                <input 
                                    type="text" 
                                    id="title" 
                                    name="title" 
                                    required 
                                    aria-required="true"
                                    aria-labelledby="title-label"
                                    aria-describedby="title-help"
                                    placeholder="Ex: BSc Computer Science"
                                >
                                <div id="title-help" class="form-help">Enter the complete programme title</div>
                            </div>
                            <div class="form-group">
                                <!-- Purpose: Collects the academic level of the programme.
                                   Functionality: Provides a dropdown for selecting undergraduate or postgraduate level.
                                   Client-Side Role: Specifies the programme’s academic category.
                                   Logic: Enforces selection with required attribute and accessibility labels.
                                -->
                                <label for="level" id="level-label">Level *</label>
                                <select 
                                    id="level" 
                                    name="level" 
                                    required 
                                    aria-required="true"
                                    aria-labelledby="level-label"
                                >
                                    <option value="">Select level</option>
                                    <option value="UG">Undergraduate (UG)</option>
                                    <option value="PG">Postgraduate (PG)</option>
                                </select>
                            </div>
                        </div>
                        
                        <div class="form-grid">
                            <!-- Purpose: Groups duration and credits fields in a grid layout.
                               Functionality: Organizes related input fields for programme duration and credits.
                               Client-Side Role: Enhances form usability with a structured layout.
                               Logic: Uses CSS grid for responsive field arrangement.
                            -->
                            <div class="form-group">
                                <!-- Purpose: Collects the programme duration in years.
                                   Functionality: Provides a dropdown for selecting the programme’s duration.
                                   Client-Side Role: Specifies the programme’s length for planning.
                                   Logic: Enforces selection with required attribute and accessibility labels.
                                -->
                                <label for="duration_years" id="duration-label">Duration (Years) *</label>
                                <select 
                                    id="duration_years" 
                                    name="duration_years" 
                                    required 
                                    aria-required="true"
                                    aria-labelledby="duration-label"
                                >
                                    <option value="">Select duration</option>
                                    <option value="1">1 Year</option>
                                    <option value="2">2 Years</option>
                                    <option value="3">3 Years</option>
                                    <option value="4">4 Years</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <!-- Purpose: Collects the total credits for the programme.
                                   Functionality: Allows input of a numeric value for credits with guidance.
                                   Client-Side Role: Defines the programme’s academic weight.
                                   Logic: Uses number input with min constraint and accessibility attributes.
                                -->
                                <label for="credits" id="credits-label">Credits</label>
                                <input 
                                    type="number" 
                                    id="credits" 
                                    name="credits"
                                    min="0"
                                    aria-labelledby="credits-label"
                                    placeholder="Ex: 360"
                                >
                                <div id="credits-help" class="form-help">Total number of programme credits</div>
                            </div>
                        </div>
                        
                        <div class="form-group">
                            <!-- Purpose: Collects a detailed description of the programme.
                               Functionality: Allows admins to input a multi-line description with guidance text.
                               Client-Side Role: Captures programme objectives and target audience.
                               Logic: Uses textarea with required validation and accessibility attributes.
                            -->
                            <label for="description" id="description-label">Description *</label>
                            <textarea 
                                id="description" 
                                name="description" 
                                rows="4"
                                required 
                                aria-required="true"
                                aria-labelledby="description-label"
                                aria-describedby="description-help"
                                placeholder="Describe the programme, objectives and target audience..."
                            ></textarea>
                            <div id="description-help" class="form-help">Describe the programme, objectives and target audience</div>
                        </div>
                        
                        <div class="form-group">
                            <!-- Purpose: Collects entry requirements for the programme.
                               Functionality: Allows input of academic prerequisites and qualifications.
                               Client-Side Role: Specifies eligibility criteria for the programme.
                               Logic: Uses textarea with accessibility attributes for optional input.
                            -->
                            <label for="entry_requirements" id="requirements-label">Entry Requirements</label>
                            <textarea 
                                id="entry_requirements" 
                                name="entry_requirements" 
                                rows="3"
                                aria-labelledby="requirements-label"
                                aria-describedby="requirements-help"
                                placeholder="Describe academic requirements, prerequisites and necessary qualifications..."
                            ></textarea>
                            <div id="requirements-help" class="form-help">Academic requirements and necessary qualifications</div>
                        </div>
                        
                        <div class="form-group">
                            <!-- Purpose: Collects career prospects for the programme.
                               Functionality: Allows input of career opportunities and work areas.
                               Client-Side Role: Highlights potential career paths for programme participants.
                               Logic: Uses textarea with accessibility attributes for optional input.
                            -->
                            <label for="career_prospects" id="career-label">Career Prospects</label>
                            <textarea 
                                id="career_prospects" 
                                name="career_prospects" 
                                rows="3"
                                aria-labelledby="career-label"
                                aria-describedby="career-help"
                                placeholder="Describe career opportunities and areas of work..."
                            ></textarea>
                            <div id="career-help" class="form-help">Career opportunities and areas of work</div>
                        </div>
                        
                        <div class="form-group programme-photo-group">
                            <!-- Purpose: Collects an optional image for the programme.
                               Functionality: Allows file upload for an image with preview and removal options.
                               Client-Side Role: Enhances programme presentation with a visual element.
                               Logic: Uses hidden file input with JavaScript for preview and removal functionality.
                            -->
                            <label for="image_url" id="image-label">Programme Image</label>
                            <div class="photo-actions">
                                <label for="image_url" class="photo-upload-label">
                                    <i class="uil uil-image-plus"></i> Choose Photo
                                </label>
                                <button type="button" id="remove-image-btn" class="remove-photo-btn">Remove</button>
                            </div>
                            <input type="file" id="image_url" name="image_url" accept="image/*" style="display:none;">
                            <div class="photo-preview" style="display:none;">
                                <img id="image-preview" src="#" alt="Preview" />
                            </div>
                        </div>
                        
                        <div class="form-group">
                            <!-- Purpose: Specifies if the programme is published.
                               Functionality: Provides a checkbox to mark the programme as visible to users.
                               Client-Side Role: Controls the programme’s visibility status.
                               Logic: Uses a checkbox with value="1" for publication status.
                            -->
                            <label class="checkbox-label">
                                <input type="checkbox" id="is_published" name="is_published" value="1">
                                Publish programme
                            </label>
                            <div id="check-help" class="form-help">Check to make the programme visible to users</div>
                        </div>
                        
                        <div class="form-actions">
                            <!-- Purpose: Groups form submission and cancellation buttons.
                               Functionality: Provides buttons to submit the form or cancel editing.
                               Client-Side Role: Enables form submission or cancellation with clear actions.
                               Logic: Hides cancel button by default, shown via JavaScript during edit mode.
                            -->
                            <button type="submit" class="btn btn-primary">
                                <!-- Purpose: Submits the programme form.
                                   Functionality: Triggers form submission to create or update a programme.
                                   Client-Side Role: Initiates programme creation or editing process.
                                   Logic: Uses JavaScript to handle form submission and validation.
                                -->
                                <i class="uil uil-plus"></i>
                                <span id="submit-text">Create Programme</span>
                            </button>
                            <button type="button" class="btn btn-secondary" id="cancel-btn" style="display: none;">
                                <!-- Purpose: Cancels the editing of an existing programme.
                                   Functionality: Resets the form to create mode or cancels changes.
                                   Client-Side Role: Allows admins to abort editing without saving.
                                   Logic: Hidden by default, shown via JavaScript in edit mode.
                                -->
                                <i class="uil uil-times"></i>
                                <span>Cancel</span>
                            </button>
                        </div>
                    </form>
                    
                    <div id="form-message" class="form-message" style="display: none;">
                        <!-- Purpose: Displays feedback messages for form actions.
                           Functionality: Shows success or error messages after form submission.
                           Client-Side Role: Informs admins of form submission outcomes.
                           Logic: Hidden by default, populated and shown via JavaScript.
                        -->
                    </div>
                </div>
            </section>
            
            <section class="programmes-list-section">
                <!-- ==================================================
                   PROGRAMMES LIST SECTION
                   Purpose: Displays a table of registered programmes with search and filter options.
                   Functionality: Shows a dynamic table with programme details and actions for editing or deleting.
                   Client-Side Role: Enables admins to view, search, and filter programmes efficiently.
                   Logic: Uses JavaScript to populate table data and handle search/filter functionality.
                -->
                <div class="section-header">
                    <h2><i class="uil uil-list-ul"></i> Registered Programmes</h2>
                    <div class="section-actions">
                        <div class="search-box">
                            <i class="uil uil-search"></i>
                            <input type="text" id="programme-search" placeholder="Search programmes...">
                        </div>
                        <select id="filter-level" class="filter-select">
                            <option value="">All levels</option>
                            <option value="UG">Undergraduate (UG)</option>
                            <option value="PG">Postgraduate (PG)</option>
                        </select>
                        <select id="filter-status" class="filter-select">
                            <option value="">All status</option>
                            <option value="published">Published</option>
                            <option value="draft">Drafts</option>
                        </select>
                    </div>
                </div>
                
                <div class="programmes-table-container">
                    <table class="programmes-table" role="table" aria-label="Programmes list">
                        <thead>
                            <tr>
                                <th scope="col">Title</th>
                                <th scope="col">Level</th>
                                <th scope="col">Duration</th>
                                <th scope="col">Credits</th>
                                <th scope="col">Status</th>
                                <th scope="col">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Data filled via JavaScript -->
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    </main>

    <footer>
        <!-- ==================================================
           FOOTER SECTION
           Purpose: Displays copyright information for the Student Course Hub.
           Functionality: Presents a static notice to assert ownership and legal rights.
           Client-Side Role: Provides legal context at the page’s bottom.
           Logic: Uses a small tag for minimalistic presentation of static 2025 copyright text.
        -->
        <div class="footer_copyright">
            <small>© 2025 Student Course Hub. All rights reserved.</small>
        </div>
    </footer>

    <script src="{{ base_path() }}/js/admin-programmes.js"></script>
    <!-- ==================================================
       SCRIPT SECTION
       Purpose: Loads JavaScript for dynamic and interactive programme management features.
       Functionality: Enables form submission, table population, search, and filter functionality.
       Client-Side Role: Enhances user interaction with dynamic data handling and form validation.
       Logic: Loads admin-programmes.js for client-side logic and uses base_path() for dynamic routing.
    -->
</body>
</html>