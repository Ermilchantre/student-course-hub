<!DOCTYPE html>
<!-- ==================================================
   DOCUMENT TYPE
   Purpose: Declares the document as HTML5 to ensure standardized rendering.
   Functionality: Instructs browsers to use HTML5 standards, enabling modern web features and consistent parsing.
   Client-Side Role: Ensures compatibility with modern browsers for proper page display.
   Logic: Uses DOCTYPE declaration to prevent quirks mode and enforce HTML5 rendering.
-->
<html lang="en">
<!-- ==================================================
   HTML ELEMENT
   Purpose: Root container for the Register Interest page, specifying the document language.
   Functionality: Sets English as the language for accessibility and contains all page content.
   Client-Side Role: Encapsulates navigation, header, form, footer, and scripts for interest registration.
   Logic: Uses lang="en" to support screen readers and ensure proper text directionality.
-->
<head>
    <!-- ==================================================
       HEAD SECTION
       Purpose: Configures metadata, page title, and external resources for styling.
       Functionality: Defines character encoding, responsive viewport, title, and links to CSS and fonts.
       Client-Side Role: Controls visual presentation and resource loading for the Register Interest page.
       Logic: Loads styles1.css, register-interest.css, Unicons, and Montserrat font for consistent styling.
    -->
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register Interest - Student Course Hub</title>
    <!-- Purpose: Sets a static page title for the Register Interest page.
       Functionality: Displays "Register Interest - Student Course Hub" in the browser tab.
       Client-Side Role: Identifies the page’s purpose for users.
       Logic: Uses a static title to indicate the interest registration context.
    -->
    <link rel="stylesheet" href="{{ base_path() }}/css/styles1.css">
    <link rel="stylesheet" href="{{ base_path() }}/css/register-interest.css">
    <link rel="stylesheet" href="https://unicons.iconscout.com/release/v2.1.6/css/unicons.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
</head>
<body>
    <!-- ==================================================
       BODY SECTION
       Purpose: Contains all visible content for registering programme interest.
       Functionality: Structures navigation, header, registration form, and footer.
       Client-Side Role: Renders an interactive interface for users to submit interest in programmes.
       Logic: Uses semantic HTML, dynamic data rendering, and JavaScript for form validation and submission.
    -->
    <nav>
        <!-- ==================================================
           NAVIGATION SECTION
           Purpose: Provides navigation for accessing key site pages.
           Functionality: Includes links to Home, About, Contact, and responsive menu toggles.
           Client-Side Role: Enables users to navigate the site with a clear menu structure.
           Logic: Uses dynamic URLs via base_path() and JavaScript for mobile menu toggling with aria-labels.
        -->
        <div class="container nav_container">
            <a href="{{ base_path() }}"><h4><i class="uil uil-graduation-cap"></i> Student Course Hub</h4></a>
            <ul class="nav_menu">
                <li><a href="{{ base_path() }}/"><i class="uil uil-home-alt"></i> Home</a></li>
                <li><a href="{{ base_path() }}/about"><i class="uil uil-info-circle"></i> About</a></li>
                <li><a href="#footer"><i class="uil uil-envelope"></i> Contact</a></li>
            </ul>
            <button id="open-menu-btn" aria-label="Open navigation menu"><i class="uil uil-bars"></i></button>
            <button id="close-menu-btn" aria-label="Close navigation menu"><i class="uil uil-multiply"></i></button>
        </div>
    </nav>

    <header class="register-header">
        <!-- ==================================================
           HEADER SECTION
           Purpose: Introduces the Register Interest page with key benefits.
           Functionality: Displays a title, description, and benefits of registering interest.
           Client-Side Role: Provides an overview of the page’s purpose and encourages form submission.
           Logic: Uses a two-column layout with text and an icon for visual clarity.
        -->
        <div class="container register-header_container">
            <div class="register-header_left">
                <h1>Register Your Interest</h1>
                <p>Take the first step towards your future. Register your interest in our programmes and we'll keep you updated with the latest information, application deadlines, and exclusive events.</p>
                <div class="register-benefits">
                    <div class="benefit">
                        <i class="uil uil-bell"></i>
                        <span>Get notified about application deadlines</span>
                    </div>
                    <div class="benefit">
                        <i class="uil uil-calendar-alt"></i>
                        <span>Receive invites to open days and events</span>
                    </div>
                    <div class="benefit">
                        <i class="uil uil-envelope"></i>
                        <span>Stay updated with programme changes</span>
                    </div>
                </div>
            </div>
            <div class="register-header_right">
                <div class="register-image">
                    <i class="uil uil-user-plus"></i>
                </div>
            </div>
        </div>
    </header>

    <section class="register-form">
        <!-- ==================================================
           REGISTER FORM SECTION
           Purpose: Provides a form for users to register their interest in a programme.
           Functionality: Collects user details (name, email, phone, programme, message) and preferences.
           Client-Side Role: Enables users to submit interest with validation and accessibility support.
           Logic: Uses POST form with dynamic programme options and JavaScript for validation.
        -->
        <div class="container register-form_container">
            <!-- Purpose: Wraps the form for layout and styling.
               Functionality: Organizes form elements within a centered container.
               Client-Side Role: Enhances form usability with a clean, responsive layout.
               Logic: Uses CSS classes for consistent styling and alignment.
            -->
            <div class="form-wrapper">
                <!-- Purpose: Groups form content with a title and icon for clarity.
                   Functionality: Displays a heading and icon to introduce the form.
                   Client-Side Role: Provides visual context for the registration process.
                   Logic: Uses a wrapper div with an icon for aesthetic and accessibility purposes.
                -->
                <div class="form-top-icon">
                    <i class="uil uil-graduation-cap" aria-label="Formulário de interesse acadêmico"></i>
                </div>
                <h2>Start Your Journey With Us</h2>
                <form id="interest-form" action="{{ base_path() }}/register-interest" method="POST">
                    <!-- Purpose: Defines the form for registering programme interest.
                       Functionality: Collects required user data and submits it via POST.
                       Client-Side Role: Facilitates interest registration with validation.
                       Logic: Uses dynamic action URL and required fields with aria attributes.
                    -->
                    <div class="form-grid">
                        <!-- Purpose: Groups name and email fields in a grid layout.
                           Functionality: Organizes related inputs for better usability.
                           Client-Side Role: Enhances form layout for clarity and responsiveness.
                           Logic: Uses CSS grid for structured field arrangement.
                        -->
                        <div class="form-group">
                            <!-- Purpose: Collects the user’s full name.
                               Functionality: Allows input of a name with validation.
                               Client-Side Role: Captures the user’s identity.
                               Logic: Uses required text input with aria-required for accessibility.
                            -->
                            <label for="name">Full Name *</label>
                            <input type="text" id="name" name="name" required aria-required="true" placeholder="Enter your full name">
                        </div>
                        <div class="form-group">
                            <!-- Purpose: Collects the user’s email address.
                               Functionality: Allows input of an email with format validation.
                               Client-Side Role: Captures contact information for communication.
                               Logic: Uses required email input with aria-required for accessibility.
                            -->
                            <label for="email">Email Address *</label>
                            <input type="email" id="email" name="email" required aria-required="true" placeholder="Enter your email address">
                        </div>
                        <div class="form-group">
                            <!-- Purpose: Collects the user’s phone number.
                               Functionality: Allows input of a phone number with validation.
                               Client-Side Role: Provides additional contact information.
                               Logic: Uses required tel input with aria-required for accessibility.
                            -->
                            <label for="phone">Phone Number</label>
                            <input type="tel" id="phone" name="phone" required aria-required="true" placeholder="+44 1234 567890">
                        </div>
                        <div class="form-group">
                            <!-- Purpose: Collects the programme of interest.
                               Functionality: Provides a dropdown of available programmes.
                               Client-Side Role: Specifies the user’s programme preference.
                               Logic: Uses select with dynamic options and aria-required for accessibility.
                            -->
                            <label for="program">Programme of Interest *</label>
                            <select id="program" name="program_id" required aria-required="true">
                                <option value="">Select a programme</option>
                                {% for programme in programmes %}
                                    <option value="{{ programme.id }}">{{ programme.title }} ({{ programme.level == 'UG' ? 'UG' : 'PG' }})</option>
                                {% endfor %}
                            </select>
                        </div>
                    </div>
                    <div class="form-group">
                        <!-- Purpose: Collects additional user information or questions.
                           Functionality: Allows input of a multi-line message.
                           Client-Side Role: Captures extra details about the user’s interest.
                           Logic: Uses required textarea with aria-required for accessibility.
                        -->
                        <label for="message">Additional Information</label>
                        <textarea id="message" name="message" rows="4" required aria-required="true" placeholder="Tell us more about your interests or any questions you have..."></textarea>
                    </div>
                    <div class="form-group checkbox-group">
                        <!-- Purpose: Collects user preference for newsletter updates.
                           Functionality: Provides an optional checkbox for receiving updates.
                           Client-Side Role: Allows users to opt into programme notifications.
                           Logic: Uses unchecked checkbox for user choice; lacks aria-label.
                        -->
                        <label class="checkbox-label">
                            <input type="checkbox" id="newsletter" name="newsletter">
                            <span class="checkmark"></span>
                            I would like to receive updates about programmes and events
                        </label>
                    </div>
                    <div class="form-group checkbox-group">
                        <!-- Purpose: Collects user consent for privacy policy and contact.
                           Functionality: Requires a checkbox for privacy agreement.
                           Client-Side Role: Ensures user consent for data usage and communication.
                           Logic: Uses required checkbox with link to privacy policy; lacks aria-label.
                        -->
                        <label class="checkbox-label">
                            <input type="checkbox" id="privacy" name="privacy" required>
                            <span class="checkmark"></span>
                            I agree to the <a href="#" class="link">Privacy Policy</a> and consent to being contacted about my interest
                        </label>
                    </div>
                    <button type="submit" class="btn btn-primary" aria-label="Submit interest form">
                        <!-- Purpose: Submits the interest registration form.
                           Functionality: Triggers form submission to register user interest.
                           Client-Side Role: Initiates the registration process.
                           Logic: Uses JavaScript for validation and submission with aria-label for accessibility.
                        -->
                        <i class="uil uil-message"></i>
                        Register Interest
                    </button>
                </form>
            </div>
        </div>
    </section>

    <footer class="footer" id="footer">
        <!-- ==================================================
           FOOTER SECTION
           Purpose: Provides contact information, links, and copyright notice.
           Functionality: Includes site logo, navigation links, contact details, and social media icons.
           Client-Side Role: Offers users additional navigation and contact options.
           Logic: Uses semantic HTML with dynamic URLs via base_path() and aria-labels for accessibility.
        -->
        <div class="container footer_container">
            <div class="footer_1">
                <a href="{{ base_path() }}" class="footer_logo"><h4>Student Course Hub</h4></a>
                <p>Explore your future with our diverse range of programmes.</p>
            </div>
            <div class="footer_2">
                <h4>Know More</h4>
                <ul>
                    <li><a href="{{ base_path() }}">Home</a></li>
                    <li><a href="{{ base_path() }}/about">About</a></li>
                    <li><a href="{{ base_path() }}/contact">Contact</a></li>
                </ul>
            </div>
            <div class="footer_3">
                <h4>Privacy</h4>
                <ul>
                    <li><a href="#">Privacy Policy</a></li>
                    <li><a href="#">Terms of Condition</a></li>
                    <li><a href="#">Refund Policy</a></li>
                </ul>
            </div>
            <div class="footer_4">
                <h4>Contact Us</h4>
                <div>
                    <p>+44 123 456 7890</p>
                    <p>info@university.ac.uk</p>
                </div>
                <ul class="footer_social">
                    <li><a href="#" aria-label="Facebook"><i class="uil uil-facebook-f"></i></a></li>
                    <li><a href="#" aria-label="Instagram"><i class="uil uil-instagram-alt"></i></a></li>
                    <li><a href="#" aria-label="Twitter"><i class="uil uil-twitter"></i></a></li>
                    <li><a href="#" aria-label="LinkedIn"><i class="uil uil-linkedin-alt"></i></a></li>
                </ul>
            </div>
        </div>
        <div class="footer_copyright">
            <small>Copyright © Student Course Hub 2025</small>
        </div>
    </footer>

    <script src="{{ base_path() }}/js/main.js"></script>
    <script src="{{ base_path() }}/js/register-interest.js"></script>
    <!-- ==================================================
    // SCRIPT SECTION
    // Purpose: Loads JavaScript for dynamic form functionality.
    // Functionality: Enables form validation and submission handling for interest registration.
    // Client-Side Role: Enhances user interaction with real-time validation and submission feedback.
    // Logic: Loads main.js for shared functionality and register-interest.js for form-specific features.
    -->
</body>
</html>